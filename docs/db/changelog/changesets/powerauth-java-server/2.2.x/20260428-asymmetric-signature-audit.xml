<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1" logicalFilePath="powerauth-java-server/2.2.x/20260428-asymmetric-signature-audit.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_signature_audit" columnName="signature_algorithm"/>
            </not>
        </preConditions>
        <comment>Add signature_algorithm column to pa_signature_audit table to store the signature algorithm</comment>
        <addColumn tableName="pa_signature_audit">
            <column name="signature_algorithm" type="varchar(32)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" logicalFilePath="powerauth-java-server/2.2.x/20260428-asymmetric-signature-audit.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_signature_audit" columnName="signature_format"/>
            </not>
        </preConditions>
        <comment>Add signature_format column to pa_signature_audit table to store the asymmetric signature format (DER/JOSE)</comment>
        <addColumn tableName="pa_signature_audit">
            <column name="signature_format" type="varchar(32)"/>
        </addColumn>
    </changeSet>

    <changeSet id="3" logicalFilePath="powerauth-java-server/2.2.x/20260428-asymmetric-signature-audit.xml" author="Roman Strobl">
        <comment>Change data type of signature column in pa_signature_audit table from varchar(255) to varchar(8000) to support longer asymmetric signatures</comment>
        <modifyDataType tableName="pa_signature_audit" columnName="signature" newDataType="varchar(8000)"/>
    </changeSet>

</databaseChangeLog>
