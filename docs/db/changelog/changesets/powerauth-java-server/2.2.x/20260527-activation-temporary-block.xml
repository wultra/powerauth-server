<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1" logicalFilePath="powerauth-java-server/2.2.x/20260527-activation-temporary-block.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_activation" columnName="timestamp_block_expire"/>
            </not>
        </preConditions>
        <comment>Add timestamp_block_expire column to pa_activation table to allow automatic unblocking of activations after a temporary time period</comment>
        <addColumn tableName="pa_activation">
            <column name="timestamp_block_expire" type="datetime"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" logicalFilePath="powerauth-java-server/2.2.x/20260527-activation-temporary-block.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_activation" columnName="temporary_block_count"/>
            </not>
        </preConditions>
        <comment>Add temporary_block_count column to pa_activation table to extend the block period for consecutive blocks</comment>
        <addColumn tableName="pa_activation">
            <column name="temporary_block_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>

