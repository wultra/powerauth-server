<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <changeSet id="1" logicalFilePath="powerauth-java-server/2.0.x/20251231-allow-null-legacy-server-keypair.xml" author="Jan Pesek">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="pa_activation" columnName="server_private_key_base64" />
            </and>
        </preConditions>
        <comment>Change the server_private_key_base64 column to nullable in the pa_activation table</comment>
        <dropNotNullConstraint tableName="pa_activation" columnName="server_private_key_base64" columnDataType="varchar(255)" />
    </changeSet>

    <changeSet id="2" logicalFilePath="powerauth-java-server/2.0.x/20251231-allow-null-legacy-server-keypair.xml" author="Jan Pesek">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="pa_activation" columnName="server_public_key_base64" />
            </and>
        </preConditions>
        <comment>Change the server_public_key_base64 column to nullable in the pa_activation table</comment>
        <dropNotNullConstraint tableName="pa_activation" columnName="server_public_key_base64" columnDataType="varchar(255)" />
    </changeSet>

</databaseChangeLog>
