<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1" logicalFilePath="powerauth-java-server/2.0.x/20250925-crypto4-activation-confirmation.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_activation" columnName="upgrade_confirmation_pending" />
            </not>
        </preConditions>
        <comment>Add column upgrade_confirmation_pending to pa_activation table</comment>
        <addColumn tableName="pa_activation">
            <column name="upgrade_confirmation_pending" type="boolean" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" logicalFilePath="powerauth-java-server/2.0.x/20250925-crypto4-activation-confirmation.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_activation" columnName="ctr_data_v4" />
            </not>
        </preConditions>
        <comment>Add column ctr_data_v4 to pa_activation table</comment>
        <addColumn tableName="pa_activation">
            <column name="ctr_data_v4" type="varchar(255)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>