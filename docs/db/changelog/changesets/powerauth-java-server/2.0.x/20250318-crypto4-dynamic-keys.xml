<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1" logicalFilePath="powerauth-java-server/2.0.x/20250314-crypto4-dynamic-keys.xml" author="Roman Strobl">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pa_activation" columnName="biometric_factor_enabled" />
                <columnExists tableName="pa_activation" columnName="biometric_factor_key" />
                <columnExists tableName="pa_activation" columnName="biometric_factor_key_next" />
                <columnExists tableName="pa_activation" columnName="knowledge_factor_key" />
                <columnExists tableName="pa_activation" columnName="knowledge_factor_key_next" />
            </not>
        </preConditions>
        <comment>Add columns for crypto4 dynamic keys to pa_activation table</comment>
        <addColumn tableName="pa_activation">
            <column name="biometric_factor_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="biometric_factor_key" type="varchar(255)"/>
            <column name="biometric_factor_key_next" type="varchar(255)"/>
            <column name="knowledge_factor_key" type="varchar(255)"/>
            <column name="knowledge_factor_key_next" type="varchar(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>